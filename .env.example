# Environment Configuration

# Provider selection: 'huggingface' (local), 'gemini', or 'openai'
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Provider: 'gemini', 'openai', or 'mock'
LLM_PROVIDER=mock

# API Keys (optional if using local/mock)
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ChromaDB Settings
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=knowledge_base

# Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval & Reranking Settings
RETRIEVER_TOP_K=10
RERANKER_TOP_N=3

# Server Settings
HOST=0.0.0.0
PORT=8000
