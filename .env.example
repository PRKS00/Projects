# Environment Configuration - Hugging Face Free Models

# Embedding Provider: 'huggingface' (free local sentence-transformers), 'mock', 'gemini', 'openai'
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Provider: 'huggingface' (local free model), 'huggingface_endpoint' (free HF inference API), 'mock', 'gemini', 'openai'
LLM_PROVIDER=huggingface
HUGGINGFACE_LLM_MODEL=google/flan-t5-base

# Hugging Face Free Token (Optional for free HF serverless inference API)
HUGGINGFACEHUB_API_TOKEN=
HF_TOKEN=

# Optional Cloud API Keys
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ChromaDB Settings
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=knowledge_base

# Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval & Reranking Settings
RETRIEVER_TOP_K=10
RERANKER_TOP_N=3

# Server Settings
HOST=0.0.0.0
PORT=8000
